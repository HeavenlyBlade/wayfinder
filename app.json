{
  "expo": {
    "name": "Wayfinder",
    "slug": "wayfinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071209"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071209"
      },
      "package": "com.sacli.wayfinder",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "WAYFINDER needs camera access for AR navigation."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "WAYFINDER needs your location to guide you around campus."
        }
      ],
      "expo-audio",
      "expo-sensors",
      "expo-asset",
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "hidden"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "09c56270-ff74-462f-8bea-70366d378598"
      }
    }
  }
}
