{
  "expo": {
    "name": "Wayfinder",
    "slug": "wayfinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071209"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071209"
      },
      "package": "com.sacli.wayfinder",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "./plugins/withApkName",
      [
        "expo-camera",
        {
          "cameraPermission": "WAYFINDER needs camera access for AR navigation."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "WAYFINDER needs your location to guide you around campus."
        }
      ],
      "expo-audio",
      "expo-sensors",
      "expo-asset",
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "hidden"
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": "AR"
          }
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "position": "absolute",
        "visibility": "hidden"
      },
      "eas": {
        "projectId": "30e57c87-7d6c-42bc-a7d3-6d6b630a5e38"
      }
    },
    "owner": "hayven"
  }
}
